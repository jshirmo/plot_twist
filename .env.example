# Server-only secrets. Never prefix these names with VITE_, commit a .env file,
# or paste a key into the browser. Configure the same values in your host's secret manager.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"

# TMDB requires either its v4 read-access token or v3 API key. The app uses
# TMDB title IDs and region-specific watch-provider metadata before Gemini ranks.
TMDB_API_READ_ACCESS_TOKEN=""
TMDB_API_KEY=""

# Optional but recommended for quota control. Public Google Books searches also work without it.
GOOGLE_BOOKS_API_KEY=""

# Firebase Admin verifies the authenticated Firebase ID token and reads users/{uid}
# on the server. For local development, put the single-line service-account JSON here.
# In Cloud Run/Firebase App Hosting, attach a service account instead of setting this variable.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Public, non-secret setting for teammates running the frontend on another PC.
# Example: VITE_API_BASE_URL="https://plot-twist-dev.example.com"
# Leave blank when this Express server and the frontend are deployed together.
VITE_API_BASE_URL=""

# Required only if the frontend and API are on different origins. Use exact URLs,
# separated by commas; never use * because authenticated requests use bearer tokens.
CORS_ALLOWED_ORIGINS="http://localhost:3000"
